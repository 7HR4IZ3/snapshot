{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "declaration": false,
    "sourceMap": false,
  },
  "include": ["src"],
  "exclude": [
    "test",
    "scripts",
    "node_modules",
    "fastify-*",
    "fastify-test-repo",
    "fastify-clone",
  ],
}
